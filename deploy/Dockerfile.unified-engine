FROM astro-backend-astro-calc-engine:latest

USER root
RUN pip install --no-cache-dir reportlab opencv-python-headless

WORKDIR /app
COPY worker/ ./worker/
COPY worker/unified_engine.py ./server.py

ENV PYTHONPATH="/app:/app/worker"
ENV PORT=8081
ENV PYTHONUNBUFFERED=1
ENV VAULT_DB_PATH="/app/data/astro_vault.db"

RUN mkdir -p /app/data

EXPOSE 8081

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/health')" || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8081", "--workers", "4"]
